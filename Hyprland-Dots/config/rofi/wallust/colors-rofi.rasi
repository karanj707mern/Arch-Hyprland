 /* wallust template - colors-rofi */

* {
active-background: #F485A9;
active-foreground: #FEF5FE;
normal-background: #120010;
normal-foreground: #FEF5FE;
urgent-background: #F487AB;
urgent-foreground: #FEF5FE;

alternate-active-background: #866D8F;
alternate-active-foreground: #FEF5FE;
alternate-normal-background: #120010;
alternate-normal-foreground: #FEF5FE;
alternate-urgent-background: #120010;
alternate-urgent-foreground: #FEF5FE;

selected-active-background: #F485A9;
selected-active-foreground: #120010;
selected-normal-background: #F485A9;
selected-normal-foreground: #120010;
selected-urgent-background: #866D8F;
selected-urgent-foreground: #120010;

background-color: #120010;
background: rgba(0,0,0,0.7);
foreground: #FEF5FE;
border-color: #F485A9;

color0: #120010;
color1: #65526B;
color2: #65526B;
color3: #65526B;
color4: #B7647F;
color5: #B76580;
color6: #BEA9BC;
color7: #F6E8F5;
color8: #ACA2AB;
color9: #866D8F;
color10: #866D8F;
color11: #866D8F;
